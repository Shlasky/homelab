# For Traefik label substitution
DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com

# VPN - Gluetun
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=wireguard
OPENVPN_USER=your_openvpn_user
OPENVPN_PASSWORD=your_openvpn_password

# Wireguard
WIREGUARD_PRIVATE_KEY=your_private_key
WIREGUARD_PUBLIC_KEY=your_public_key
WIREGUARD_ENDPOINT_IP=1.2.3.4
WIREGUARD_ENDPOINT_PORT=51820
WIREGUARD_ADRESSES=10.x.x.x/16
WIREGUARD_DNS=1.1.1.1,8.8.8.8

# Gluetun settings
DOT=off
BLOCK_MALICIOUS=off
FIREWALL_OUTBOUND_SUBNETS=10.0.0.0/32
FIREWALL_VPN_INPUT_PORTS=6881
FIREWALL_INPUT_PORTS=6881
LOG_LEVEL=info

# qBittorrent
WEBUI_PORT=8090
DISABLE_HOST_HEADER_CHECK=1
