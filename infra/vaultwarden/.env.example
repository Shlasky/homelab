# Vaultwarden requires full URL with protocol (overrides base DOMAIN)
DOMAIN=https://vault.example.com
DATABASE_URL=postgresql://vaultwarden:changeme@postgres:5432/vaultwarden
# Generate with: echo -n "your_token" | argon2 ... (see vaultwarden docs)
ADMIN_TOKEN=$argon2id$v=19$..._your_argon2_hash_here
SIGNUPS_ALLOWED=true
WEBSOCKET_ENABLED=true

# SMTP — uncomment and fill to enable email (hints, 2FA, invites)
# SMTP_HOST=smtp.example.com
# SMTP_FROM=vault@yourdomain.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Push notifications — uncomment after getting credentials from bitwarden.com/host
# PUSH_ENABLED=true
# PUSH_INSTALLATION_ID=
# PUSH_INSTALLATION_KEY=
