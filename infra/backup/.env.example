# Cloudflare R2 (S3-compatible backend for restic)
# Create an R2 bucket and API token at: dash.cloudflare.com → R2 → Manage API tokens
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# Restic repository URL
# Format: s3:https://<account-id>.r2.cloudflarestorage.com/<bucket-name>
RESTIC_REPOSITORY=

# Restic encryption password — store this somewhere safe (e.g. Vaultwarden)
# Without this you CANNOT restore. Generate with: openssl rand -base64 32
RESTIC_PASSWORD=

# PostgreSQL credentials (mirror from infra/db/postgres/.env)
POSTGRES_USER=
POSTGRES_PASSWORD=

# MongoDB credentials (mirror from infra/db/mongodb/.env)
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

# n8n webhook URL for backup success/failure notifications
# Create a webhook trigger node in n8n and paste the URL here
BACKUP_NOTIFY_URL=
