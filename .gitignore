# Claude
.CLAUDE.md
*/.CLAUDE.md

# Obsidian workspace files (personal settings)
.obsidian/workspace*
.obsidian/cache
.trash/

# Operating System
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Environment variables and secrets
.env
.env.local
.env.*.local
*.key
*.pem
*.crt
secrets/
credentials/

# But allow example files
!.env.example
!.env.*.example

# Docker volumes and runtime data
**/data/
*/volumes/
*/cache/
*_data/

# Logs
*.log
logs/

# Backup files
*.bak
*.backup
backups/

# Temporary files
tmp/
temp/
*.tmp

# Database files (keep configs, not data)
*.db
*.sqlite
*.sql.gz

# Personal notes you don't want to share
PERSONAL.md
PASSWORDS.md

# Large media files 
*.iso
*.img
*.mp4
*.mkv
*.avi

# IDE specific
.vscode/
.idea/
*.code-workspace

# Traefik runtime
**/acme/

# Jellyfin runtime
**/jellyfin/config/
**/jellyfin/cache/
**/jellyfin/cache-backup/
**/jellyseerr/

# Torrent/VPN runtime
**/torrent/gluetun/
**/torrent/qbittorrent/
wireguard.conf

# Arr stack runtime configs
**/arr/bazarr/
**/arr/prowlarr/
**/arr/sonarr/
**/arr/radarr/

# Registry secrets and data (config.yml is OK, keys and blobs are not)
**/registry/auth/*.key
**/registry/auth/*.pem
**/registry/data/

# Game servers runtime
**/minecraft/data/
**/minecraft/modpacks/
**/satisfactory/config/

# Monitoring runtime data
**/grafana/data/
**/prometheus/data/
**/loki/data/
**/tempo/data/
**/alertmanager/data/
**/promtail/positions/

# Homepage logs
**/homepage/**/config/logs/

# Dockhand DB
**/dockhand/data/

# MongoDB runtime data
**/mongodb/data/

# PostgreSQL runtime data
**/postgres/data/
**/postgres/pgadmin-data/

# n8n runtime data
**/n8n/data/

